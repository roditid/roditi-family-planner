# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Google OAuth / Calendar ----
# Create OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs must include:
#   <APP_URL>/auth/callback  (app login)
#   <APP_URL>/api/calendar/connect/callback  (calendar connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/connect/callback

# ---- Resend (email reminders) ----
# https://resend.com — 3k/month free tier
RESEND_API_KEY=
REMINDER_FROM_EMAIL=pickup-planner@your-domain.com

# ---- Optional: Twilio (swap-in for SMS) ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---- Optional: Google Maps (travel estimates / static preview) ----
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-me-to-a-long-random-string
